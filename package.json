{
  "name": "dsh-abap-editor",
  "version": "0.2.0",
  "description": "ABAP syntax highlighting for the official DSH Sidebar document preview: a read-only CodeMirror 6 body with a vendored ABAP grammar for .abap files.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/revolveyao/dsh-abap-editor.git"
  },
  "bugs": {
    "url": "https://github.com/revolveyao/dsh-abap-editor/issues"
  },
  "homepage": "https://github.com/revolveyao/dsh-abap-editor#readme",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node tests/smoke.mjs",
    "gen:keywords": "node scripts/gen-keywords.mjs"
  },
  "dependencies": {
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@lezer/highlight": "^1.2.3"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "prismjs": "^1.30.0"
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "abap",
    "syntax-highlight",
    "codemirror"
  ],
  "license": "MIT"
}
